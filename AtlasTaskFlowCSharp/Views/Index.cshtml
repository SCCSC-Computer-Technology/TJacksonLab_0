@{
    ViewData["Title"] = "My Tasks";
}

<div class="container py-5">
    <h1 class="display-5 fw-bold">My Tasks</h1>

    <p class="lead">
        Welcome to your Atlas TaskFlow workspace!
    </p>

    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <h2 class="h5">Your Task List</h2>
            <p>You can organize your work here.</p>

            <p class="text-muted">
                Task creation is coming next!
            </p>
        </div>
    </div>

    <a class="btn btn-outline-primary mt-3"
       asp-controller="Home"
       asp-action="Index">
        Back to Home
    </a>
</div>

